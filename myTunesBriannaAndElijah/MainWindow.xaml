<Window x:Class="myTunesBriannaAndElijah.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:myTunesBriannaAndElijah"
        mc:Ignorable="d"
        Title="myTunes" Height="450" Width="973" Icon="/musicNote.jpg"
        Closing="Window_Closing">

    <Window.Resources>
        <Style TargetType="Button">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Foreground" Value="LightSeaGreen"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding Command="MediaCommands.Play" Executed="playCommand_Executed" CanExecute="playCommand_CanExecute" />
        <CommandBinding Command="MediaCommands.Stop" Executed="stopCommand_Executed" CanExecute="stopCommand_CanExecute" />
        <CommandBinding Command="{x:Static local:MainWindow.RemoveCommand}"
                Executed="removeCommand_Executed"
                CanExecute="removeCommand_CanExecute"/>
    </Window.CommandBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100*"/>
            <ColumnDefinition Width="300*"/>
        </Grid.ColumnDefinitions>

        <ToolBar Grid.Row="0" Grid.ColumnSpan="2">
            <Button x:Name="addSongButton" ToolTip="Add song" Click="addSongButton_Click" >
                <Image Source="/Images/plusSymbol.jpg" Width="24" Height="24"/>
            </Button>
            <Button x:Name="newPlaylistButton" ToolTip="New playlist" Click="newPlaylistButton_Click">
                <Image Source="/Images/diskSymbol.jpg" Width="24" Height="24"/>
            </Button>
            <Separator />
            <Button x:Name="aboutSongButton" ToolTip="About myTunes" Click="aboutButton_Click" >
                <Image Source="/Images/questionSymbol.jpg" Width="24" Height="24"/>
            </Button>
            <Separator/>
            <Label Content="Search:"/>
            <TextBox x:Name="searchTextBox" Width="250" ToolTip="Search Songs" TextChanged="searchTextBox_TextChanged"/>
        </ToolBar>

        <ListBox x:Name="playlistListBox" Grid.Row="1" Margin="10,10,10,10" Grid.ColumnSpan="1" 
                 SelectionChanged="playlistListBox_SelectionChanged" ContextMenuOpening="playlistListBox_ContextMenuOpening">
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Rename" Click="renamePlaylistMenuItem_Click"/>
                    <MenuItem Header="Delete" Click="deletePlaylistMenuItem_Click"/>
                </ContextMenu>
            </ListBox.ContextMenu>

            <!--Links the drag & drop event handler to every playlist item that's added to the ListBox-->
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="AllowDrop" Value="True"/>
                    <EventSetter Event="Drop" Handler="playlistItem_Drop"/>
                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="playlistItem_PreviewMouseRightButtonDown"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <DataGrid x:Name="songsDataGrid" Grid.Row="1" Grid.Column="1" Margin="10,10,10,10" AutoGenerateColumns="False" IsReadOnly="True" 
                  PreviewMouseMove="songsDataGrid_PreviewMouseMove" SelectionMode="Single">
            <!--Claude helped write the context menu-->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="DataGridRow_PreviewMouseRightButtonDown" />
                    <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick" />
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <MenuItem Header="Play" Command="MediaCommands.Play" />
                                <MenuItem Header="Remove" Command="{x:Static local:MainWindow.RemoveCommand}" />
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Title"  Binding="{Binding title}"/>
                <DataGridTextColumn Header="Artist" Binding="{Binding artist}"/>
                <DataGridTextColumn Header="Album"  Binding="{Binding album}"/>
                <DataGridTextColumn Header="Genre"  Binding="{Binding genre}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="10,0,10,10">
            <Button Content="Play" Command="MediaCommands.Play" Width="80" Margin="0,0,8,0" ToolTip="Play the selected song" />
            <Button Content="Stop" Command="MediaCommands.Stop" Width="80" ToolTip="Stop the song" />
        </StackPanel>

    </Grid>
</Window>
