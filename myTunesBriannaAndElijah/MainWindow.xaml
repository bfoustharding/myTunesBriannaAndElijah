<Window x:Class="myTunesBriannaAndElijah.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:myTunesBriannaAndElijah"
        mc:Ignorable="d"
        Title="myTunes" Height="450" Width="973" Icon="/musicNote.jpg">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100*"/>
            <ColumnDefinition Width="300*"/>
        </Grid.ColumnDefinitions>

        <!--TODO: Use icons rather than text buttons-->
        <ToolBar Grid.Row="0" Grid.ColumnSpan="2">
            <Button x:Name="addSongButton" Content="Add song" ToolTip="Add song" Click="addSongButton_Click" />
            <Button x:Name="newPlaylistButton" Content="New playlist" ToolTip="New playlist" Click="newPlaylistButton_Click"/>
            <Separator />
            <Button x:Name="aboutSongButton" Content="About" ToolTip="About myTunes" Click="aboutButton_Click" />
        </ToolBar>

        <!--Claude: how do I add an event handler for when the selected item in my listbox is changed-->
        <ListBox x:Name="playlistListBox" Grid.Row="1" Margin="10,10,10,10" Grid.ColumnSpan="1" SelectionChanged="playlistListBox_SelectionChanged"/>
        
        <DataGrid x:Name="songsDataGrid" Grid.Row="1" Grid.Column="1" Margin="10,10,10,10"
          AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <!--Claude: how can I custom name the columns of my DataGrid-->
                <DataGridTextColumn Header="Title"  Binding="{Binding title}"/>
                <DataGridTextColumn Header="Artist" Binding="{Binding artist}"/>
                <DataGridTextColumn Header="Album"  Binding="{Binding album}"/>
                <DataGridTextColumn Header="Genre"  Binding="{Binding genre}"/>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Window>
