<Window x:Class="myTunesBriannaAndElijah.PlaylistNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:myTunesBriannaAndElijah"
        mc:Ignorable="d"
        Title="PlaylistNameWindow" Height="100" Width="200">
    <StackPanel>
        <TextBox x:Name="nameTextBox"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="OK" Width="70" IsDefault="True" Click="okButton_Click" />
            <Button Content="Cancel" Width="70" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
